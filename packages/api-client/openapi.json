        ]
      }
    },
    "/api/v1/me": {
      "delete": {
        "description": "Delete the account and all its data (FR-A4).",
        "operationId": "deleteMe",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "503": {
            "description": "Data deleted; sign-in removal failed (retry)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Me",
        "tags": [
          "identity"
        ]
      },
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Me",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/me/age-confirmation": {
      "post": {
        "description": "Record the 18+ confirmation (FR-A3). Used after social sign-in (M6).",
        "operationId": "confirmAge",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Confirm Age",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/me/notification-settings": {
      "get": {
        "operationId": "getNotificationSettings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSettings"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Notification Settings",
        "tags": [
          "preferences"
        ]
      },
      "put": {
        "operationId": "putNotificationSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSettings"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Put Notification Settings",
        "tags": [
          "preferences"
        ]
      }
    },
    "/api/v1/me/preferences": {
      "get": {
        "operationId": "getPreferences",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Preferences",
        "tags": [
          "preferences"
        ]
      },
      "put": {
        "description": "Onboarding (P1-P6 plus the device time zone) and later edits from Settings (FR-P1, FR-P2).",
        "operationId": "putPreferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Put Preferences",
        "tags": [
          "preferences"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "description": "Readiness: the database answers.",
        "operationId": "getReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "ops"
        ]
      }
    },
    "/api/v1/season": {
      "get": {
        "description": "Active season, whether its schedule is out, weeks and freshness (FR-O1c, FR-SC4).",
        "operationId": "getSeason",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Season"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Season",
        "tags": [
          "schedule"
        ]
      }
    },
    "/api/v1/teams": {
      "get": {
        "operationId": "listTeams",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Team"
                  },
                  "title": "Response Listteams",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Teams",
        "tags": [
          "schedule"
        ]
      }
    },
    "/api/v1/zip/nearest": {
      "post": {
        "description": "Nearest ZIP for \"Use my location\". Coordinates travel in the body, never in URLs.",
        "operationId": "nearestZip",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Coordinates"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZipInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Nearest Zip",
        "tags": [
          "preferences"
        ]
      }
    },
    "/api/v1/zip/{zip_code}": {
      "get": {
        "operationId": "getZip",
        "parameters": [
          {
            "in": "path",
            "name": "zip_code",
            "required": true,
            "schema": {
              "pattern": "^\\d{5}$",
              "title": "Zip Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZipInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Zip",
        "tags": [
          "preferences"
        ]
      }
    }
  }
}
