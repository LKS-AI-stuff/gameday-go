      "ClientEvent": {
        "additionalProperties": false,
        "properties": {
          "client_ts": {
            "format": "date-time",
            "title": "Client Ts",
            "type": "string"
          },
          "name": {
            "enum": [
              "onboarding_started",
              "onboarding_completed",
              "plan_requested",
              "plan_first_step_rendered",
              "plan_card_rendered",
              "plan_saved",
              "watch_created"
            ],
            "title": "Name",
            "type": "string"
          },
          "platform": {
            "enum": [
              "ios",
              "android",
              "web"
            ],
            "title": "Platform",
            "type": "string"
          },
          "props": {
            "$ref": "#/components/schemas/EmptyProps"
          }
        },
        "required": [
          "name",
          "platform",
          "client_ts"
        ],
        "title": "ClientEvent",
        "type": "object"
      },
      "Coordinates": {
        "additionalProperties": false,
        "description": "Device position for \"Use my location\". Used for this request only, never stored.",
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "title": "Coordinates",
        "type": "object"
      },
      "EmptyProps": {
        "additionalProperties": false,
        "description": "No properties yet; anything sent is rejected rather than stored.",
        "properties": {},
        "title": "EmptyProps",
        "type": "object"
      },
