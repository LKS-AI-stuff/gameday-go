# Backend settings (TDD §13). Copy to .env (git-ignored) and fill in.
# Client settings live in apps/mobile/.env and apps/web/.env (EXPO_PUBLIC_* only).

APP_ENV=local
LOG_LEVEL=INFO
PUBLIC_WEB_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# Backend role gamedaygo_app (owns schema app). Pick any local password;
# `uv run python -m app.cli bootstrap-db` creates the role with it.
DATABASE_URL=postgresql+asyncpg://gamedaygo_app:CHANGE_ME@127.0.0.1:54322/postgres
# Admin connection used only by bootstrap-db (local Supabase defaults).
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase (printed by `pnpm supabase start`).
SUPABASE_URL=http://127.0.0.1:54321
# The local stack signs tokens with an asymmetric key published via JWKS.
SUPABASE_JWT_MODE=jwks
# Used only by the Data API exposure test (pytest -m supabase).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
