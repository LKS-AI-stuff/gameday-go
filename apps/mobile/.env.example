# Public client settings, inlined into the app bundle. Never put secrets here (NFR-12).
# A phone can't reach "localhost" on your Mac: use the Mac's LAN IP
# (macOS: `ipconfig getifaddr en0`), and keep the phone on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.20:54321
# Local Supabase publishable key (printed by `pnpm supabase status`).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
