    "@gamedaygo/ui": "workspace:*",
    "@hookform/resolvers": "6.0.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
